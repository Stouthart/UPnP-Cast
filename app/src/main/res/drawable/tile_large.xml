<!-- Behind a tile's cover in Browse's grid: as tile, with 8dp corners inside the tile's 12dp; the small covers and icons
     in rows keep tile's 4dp, as Apple's artwork and Material 3's extra small. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/divider" />
    <corners android:radius="8dp" />
</shape>
