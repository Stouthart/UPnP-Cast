<?xml version="1.0" encoding="utf-8"?>
<!-- The room's queue: ‹ back to Now Playing, the Queue card with Clear queue, and the tracks. The mini player's views
     are here for the player, which marks the playing track and follows the speakers, but stay hidden (Player.bar).
     fitsSystemWindows replaces the root's padding with the bar insets, so the spacing is in margins. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Back to Now Playing, as Back does; on the row Now Playing's ⌄ has, 8dp from the top, the card 8dp under it.
         The ‹ starts on the cards' content line, 36dp in, by what it draws: 8dp inside its 24dp, centred in 56dp. -->
    <ImageView
        android:id="@+id/back"
        android:layout_width="56dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/control"
        android:contentDescription="@string/back"
        android:scaleType="center"
        android:src="@drawable/ic_back" />

    <!-- The title row reaches into the card's padding, as Browse's: Clear queue's text ends on the card's content edge,
         where the mini player's Play circle ends. The padding unclipped, so the link's ripple shows whole. -->
    <LinearLayout
        style="@style/Card"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="-20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Title"
                    android:text="@string/queue" />

                <TextView
                    android:id="@+id/summary"
                    style="@style/Summary" />
            </LinearLayout>

            <TextView
                android:id="@+id/clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/press_full"
                android:fontFamily="sans-serif-medium"
                android:padding="8dp"
                android:text="@string/clear_queue"
                android:textColor="@color/accent_text"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Its scroll bar shows while it scrolls and fades after, at the screen's edge in the 16dp side padding, as the
         opening screen's and Browse's, clear of the rows. -->
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:listSelector="@android:color/transparent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:scrollbarStyle="outsideOverlay" />

    <include layout="@layout/player" />
</LinearLayout>
