<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own views and shapes: no library, no extra inflation cost. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Rooms: the checked ones play together -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:text="@string/rooms" />

                    <TextView
                        android:id="@+id/rooms_summary"
                        style="@style/Summary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Filled with rows by show(); hidden while empty. -->
            <LinearLayout
                android:id="@+id/rooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/allow"
                style="@style/Button"
                android:layout_marginTop="20dp"
                android:text="@string/allow_lan"
                android:visibility="gone" />
        </LinearLayout>

        <!-- UPnP/DLNA servers -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:text="@string/servers" />

                    <TextView
                        android:id="@+id/servers_summary"
                        style="@style/Summary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/servers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Settings: the title row opens and closes the card; closed at first, then as it was left. -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp"
            android:animateLayoutChanges="true">

            <!-- No bar: it marks a title with a summary line, as on Rooms; Settings is a title alone. -->
            <!-- 48dp to tap; the -10dp margins keep the title where it was (top and bottom apart: Android
                 ignores a negative layout_marginVertical). -->
            <LinearLayout
                android:id="@+id/settings_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="-10dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/settings" />

                <!-- Down while closed, turned up while open. -->
                <ImageView
                    android:id="@+id/settings_chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_expand" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- What the app does with the rooms first, then its look. -->
                <TextView
                    style="@style/Label"
                    android:layout_marginTop="20dp"
                    android:text="@string/volume_step" />

                <!-- As Polling interval below. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    android:layout_marginEnd="-4dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="-8dp"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_volume" />

                    <!-- 0..9 for a step of 1..10. -->
                    <SeekBar
                        android:id="@+id/step"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/volume_step"
                        android:max="9"
                        android:progressBackgroundTint="@color/text2"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />

                    <TextView
                        android:id="@+id/step_value"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text2"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="20dp"
                    android:text="@string/group_rooms" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/group_off"
                        style="@style/Segment"
                        android:layout_marginEnd="8dp"
                        android:text="@string/off" />

                    <TextView
                        android:id="@+id/group_on"
                        style="@style/Segment"
                        android:text="@string/on" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="20dp"
                    android:text="@string/polling" />

                <!-- The mini player's volume row exactly: a 40dp icon slot, the slider, the value centred in 48dp.
                     -4dp: this card has 20dp padding, the mini player 16dp, so slider and value line up with it. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-4dp"
                    android:layout_marginEnd="-4dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="-8dp"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_timer" />

                    <!-- 0..9 for 1..10 seconds: SeekBar's minimum is 0 in this layout. -->
                    <SeekBar
                        android:id="@+id/poll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/polling"
                        android:max="9"
                        android:progressBackgroundTint="@color/text2"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />

                    <TextView
                        android:id="@+id/poll_value"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text2"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="20dp"
                    android:text="@string/appearance" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/appearance_system"
                        style="@style/Segment"
                        android:text="@string/system_default" />

                    <TextView
                        android:id="@+id/appearance_light"
                        style="@style/Segment"
                        android:layout_marginHorizontal="8dp"
                        android:text="@string/light_mode" />

                    <TextView
                        android:id="@+id/appearance_dark"
                        style="@style/Segment"
                        android:text="@string/dark_mode" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Pushes the copyright to the bottom when the cards don't fill the screen. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/copyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:textColor="@color/text2"
            android:textSize="15sp" />
    </LinearLayout>
    </ScrollView>

    <include layout="@layout/player" />
</LinearLayout>
