<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own views and shapes: no library, no extra inflation cost. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Rooms: the checked ones play together. Its title row reaches into the card's padding, so Room settings ends
             where the mini player's Play circle does, its whole 40dp to tap; the card leaves its padding unclipped, so
             the button's touch feedback shows whole. -->
        <LinearLayout
            style="@style/Card"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="-20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:text="@string/rooms" />

                    <TextView
                        android:id="@+id/rooms_summary"
                        style="@style/Summary" />
                </LinearLayout>

                <!-- Room settings, as Browse's card has its actions: once there are rooms to set. Every glyph at a card's
                     right ends where the mini player's Play circle does, at the card's content edge: this one, 11dp
                     inside its 40dp, 9dp in from the row's end. -->
                <ImageView
                    android:id="@+id/room_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/control"
                    android:contentDescription="@string/room_settings"
                    android:padding="8dp"
                    android:src="@drawable/ic_tune"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Filled with rows by show(); hidden while empty. -->
            <LinearLayout
                android:id="@+id/rooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/allow"
                style="@style/Button"
                android:layout_marginTop="20dp"
                android:text="@string/allow_lan"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Favorites: a title alone, as App settings closed; a tap opens all of them in Browse. Hidden while there's
             none to play. -->
        <LinearLayout
            android:id="@+id/favorites_card"
            style="@style/Card"
            android:layout_marginTop="16dp"
            android:clipToOutline="true"
            android:clipToPadding="false"
            android:visibility="gone">

            <!-- As App settings' header: the whole card to tap, its title and › where a card's sit. -->
            <LinearLayout
                android:id="@+id/favorites_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20dp"
                android:layout_marginTop="-20dp"
                android:layout_marginEnd="-20dp"
                android:layout_marginBottom="-20dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    style="@style/Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/favorites" />

                <!-- As a server's row: they open in Browse. Ends where the Play circle does: › stops 8dp inside its box. -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="-8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- UPnP/DLNA servers -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:text="@string/servers" />

                    <TextView
                        android:id="@+id/servers_summary"
                        style="@style/Summary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/servers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Settings: the title row opens and closes the card; closed at first, then as it was left. The title row
             reaches over the card's padding to its edges, so the card leaves its padding unclipped, and clips to its own
             rounded outline: the ripple fills the card closed, its title band open, corners and all. -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp"
            android:animateLayoutChanges="true"
            android:clipToOutline="true"
            android:clipToPadding="false">

            <!-- No bar: it marks a title with a summary line, as on Rooms; Settings is a title alone. -->
            <!-- To tap, the whole card while closed, as a room's row is all of it: -20dp margins over the card's padding
                 to its edges, with 20dp padding back, so the title and the chevron stay where they were, and 68dp, the
                 closed card's height (each side apart: Android ignores a negative layout_marginVertical). -->
            <LinearLayout
                android:id="@+id/settings_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20dp"
                android:layout_marginTop="-20dp"
                android:layout_marginEnd="-20dp"
                android:layout_marginBottom="-20dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    style="@style/Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/app_settings" />

                <!-- Down while closed, turned up while open; ends at the card's content edge, where the Play circle
                     ends: ⌄ stops 6dp inside its box. -->
                <ImageView
                    android:id="@+id/settings_chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="-6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_expand" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- What the app does with the rooms first, then its look. 28dp between settings, from what's drawn; the
                     first, under the title, 20dp, and each name 10dp above its own control. -->
                <TextView
                    style="@style/Label"
                    android:layout_marginTop="20dp"
                    android:text="@string/volume_step" />

                <!-- As Polling interval below. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:layout_marginBottom="-11dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="-11dp"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_volume" />

                    <!-- 0..9 for a step of 1..10. -->
                    <SeekBar
                        android:id="@+id/step"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/volume_step"
                        android:max="9"
                        android:progressBackgroundTint="@color/text2"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />

                    <TextView
                        android:id="@+id/step_value"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text2"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="28dp"
                    android:text="@string/quick_skip" />

                <!-- As Polling interval below; -12dp: this arrow is drawn 4dp into its box. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:layout_marginBottom="-11dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="-12dp"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_skip_forward"
                        android:tint="@color/text2" />

                    <!-- 0..12 for off and 5..60 seconds, in steps of 5. -->
                    <SeekBar
                        android:id="@+id/skip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/quick_skip"
                        android:max="12"
                        android:progressBackgroundTint="@color/text2"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />

                    <TextView
                        android:id="@+id/skip_value"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text2"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="28dp"
                    android:text="@string/polling" />

                <!-- The mini player's volume row exactly: a 40dp icon slot, the slider, the value centred in 48dp.
                     -11dp at the start: the glyph, drawn 3dp into its box, starts on the label's line. The box
                     reaches 11dp above and below the glyph and the slider, so -1dp at the top and -11dp at the foot
                     count the margins from what shows: 10dp from the label, as segments are, and 20dp to what follows. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:layout_marginBottom="-11dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="-11dp"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_timer" />

                    <!-- 0..9 for 1..10 seconds: SeekBar's minimum is 0 in this layout. -->
                    <SeekBar
                        android:id="@+id/poll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/polling"
                        android:max="9"
                        android:progressBackgroundTint="@color/text2"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />

                    <TextView
                        android:id="@+id/poll_value"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text2"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="28dp"
                    android:text="@string/appearance" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/appearance_system"
                        style="@style/Segment"
                        android:text="@string/system_default" />

                    <TextView
                        android:id="@+id/appearance_light"
                        style="@style/Segment"
                        android:layout_marginHorizontal="8dp"
                        android:text="@string/light_mode" />

                    <TextView
                        android:id="@+id/appearance_dark"
                        style="@style/Segment"
                        android:text="@string/dark_mode" />
                </LinearLayout>

                <!-- The version and copyright, last in App settings: 28dp below, as between settings, centred, in
                     grey. -->
                <TextView
                    android:id="@+id/copyright"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:textColor="@color/text2"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <include layout="@layout/player" />
</LinearLayout>
