<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing: the player's views at full size, plus progress, transport and play mode. The cover is sized in code.
     20dp sides: the cover there, the text and bars 16dp further in, at 36dp from the screen's edge, where every other
     screen's content and the mini player's cover and Play circle are, as are the glyphs of the room's row. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp"
        android:paddingTop="8dp">

        <!-- Closes the sheet, as in the Sonos app; a swipe down does the same. -->
        <ImageView
            android:id="@+id/close"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/control"
            android:contentDescription="@string/close"
            android:scaleType="center"
            android:src="@drawable/ic_down" />

        <ImageView
            android:id="@+id/player_art"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:background="@drawable/cover"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- Keeps the controls and the room's row at the bottom: room the cover can't take, once it's as wide as the
             screen allows, goes here, between it and the title. -->
        <View
            android:id="@+id/spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Text and volume are inset 16dp: the SeekBars' own padding, so everything lines up with their tracks. Below the
             cover the rows stand 20dp apart by what they draw, as from the controls down: 12.4dp above the title, whose
             letters start 7.6dp into its line, and 13.8dp above the progress bar, whose dot starts 6.2dp into it. -->
        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.4dp"
            android:paddingHorizontal="16dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/player_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/player_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text2"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/player_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13.8dp"
            android:progressBackgroundTint="@color/text2"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/player_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/player_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text2"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Shuffle, Previous, Play/Pause, Next, Repeat, spread over the width as in the Sonos app; with a Quick skip
             step (Settings), its two buttons beside Play. The shares below hold until Player.spread() gives each the
             width it draws plus one even gap. Centred: the buttons take their width in whole pixels. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/player_shuffle"
                style="@style/Transport"
                android:contentDescription="@string/shuffle"
                android:padding="14dp"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/text2" />

            <ImageView
                android:id="@+id/player_previous"
                style="@style/Transport"
                android:background="@drawable/circle_quiet"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_previous" />

            <!-- The arrow at 32dp, between Previous's 36 and Shuffle's 28; the step in its circle, a little below the
                 middle as the circle is. -->
            <FrameLayout
                android:id="@+id/player_back"
                style="@style/Skip">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:paddingHorizontal="2dp"
                    android:paddingVertical="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_back" />

                <TextView
                    android:id="@+id/player_back_step"
                    style="@style/SkipStep" />
            </FrameLayout>

            <!-- 1.5 shares: a fifth of a phone's row is narrower than the 72dp circle, which then got its sides cut. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5">

                <ImageView
                    android:id="@+id/player_toggle"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle"
                    android:clickable="true"
                    android:contentDescription="@string/play"
                    android:focusable="true"
                    android:padding="20dp"
                    android:src="@drawable/ic_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/player_forward"
                style="@style/Skip">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:paddingHorizontal="2dp"
                    android:paddingVertical="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_forward" />

                <TextView
                    android:id="@+id/player_forward_step"
                    style="@style/SkipStep" />
            </FrameLayout>

            <ImageView
                android:id="@+id/player_next"
                style="@style/Transport"
                android:background="@drawable/circle_quiet"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_next" />

            <ImageView
                android:id="@+id/player_repeat"
                style="@style/Transport"
                android:contentDescription="@string/repeat"
                android:padding="14dp"
                android:src="@drawable/ic_repeat"
                android:tint="@color/text2" />
        </LinearLayout>

        <!-- 9dp above and -11dp below: the icon's box reaches 11dp past the speaker and the slider both ways, so the
             row is 20dp from the controls and the room's row, as the rows above are from each other. The speaker's
             box reaches into the row's padding, left unclipped so its touch feedback shows whole. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="-11dp"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- -11dp: the speaker itself, drawn 3dp into its box, not its touch target, starts on the line. -->
            <ImageView
                android:id="@+id/player_mute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="-11dp"
                android:background="@drawable/control"
                android:contentDescription="@string/mute"
                android:padding="8dp"
                android:src="@drawable/ic_volume" />

            <SeekBar
                android:id="@+id/player_volume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/volume"
                android:max="100"
                android:progressBackgroundTint="@color/text2"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/player_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="32dp"
                android:textColor="@color/text2"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- The room's row, on a panel where the Queue button was, 56dp as the controls' row: the Queue at the left, the
             room in the middle, and at the right the heart that saves what plays as a Sonos favourite, filled while it is
             one. Their glyphs at 28dp, as Shuffle's and Repeat's, in the middle of a 48dp touch area; each ends on its
             36dp line, 16dp inside the panel, by what it draws: the queue's 3.5dp and the heart's 2.33dp inside its box.
             The queue's glyph sits 1.17dp low in its box: its padding lifts it, so both glyphs share the panel's middle
             while their touch areas stay centred. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/panel">

            <ImageView
                android:id="@+id/player_queue"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="2.5dp"
                android:background="@drawable/control"
                android:contentDescription="@string/queue"
                android:paddingBottom="11.17dp"
                android:paddingHorizontal="10dp"
                android:paddingTop="8.83dp"
                android:src="@drawable/ic_queue" />

            <!-- Clear of the two touch areas, so a long name ends in "…" before them. -->
            <TextView
                android:id="@+id/player_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="52dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/accent_text"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/player_heart"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="3.67dp"
                android:background="@drawable/control"
                android:contentDescription="@string/favorite_add"
                android:padding="10dp"
                android:src="@drawable/ic_heart"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
