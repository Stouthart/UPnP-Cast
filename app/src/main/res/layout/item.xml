<?xml version="1.0" encoding="utf-8"?>
<!-- A container or track: cover (or icon), title, detail line, and a chevron for containers; in the Queue and in
     Favorites as a list, ✕ instead.
     Its padding unclipped, for the ✕'s feedback. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel"
    android:clipToPadding="false"
    android:foreground="@drawable/press"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/tile"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text2"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Not focusable, so a tap anywhere else still selects the row. -->
    <ImageView
        android:id="@+id/more"
        android:layout_width="24dp"
        android:layout_height="40dp"
        android:background="@drawable/control"
        android:contentDescription="@string/more"
        android:focusable="false"
        android:paddingVertical="8dp"
        android:src="@drawable/ic_more" />

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron" />

    <!-- The Queue's and Favorites': removes the track or the favourite. Its glyph, drawn 5dp inside the 24dp box at the middle of its 48dp touch area,
         ends 20dp inside the row, as a room row's last glyph; the area reaches 9dp into the row's padding. Not
         focusable, so a tap anywhere else still plays the track. -->
    <ImageView
        android:id="@+id/remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="-9dp"
        android:background="@drawable/control"
        android:contentDescription="@string/remove_track"
        android:focusable="false"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        android:visibility="gone" />
</LinearLayout>
