<?xml version="1.0" encoding="utf-8"?>
<!-- A room's level: its name, then the mini player's volume row exactly, as the main screen's settings have it: a 40dp
     icon slot, the slider, the value centred in 48dp. -4dp: these cards have 20dp padding, the mini player 16dp, so
     slider and value line up with it. That row reaches 4dp past this level's edge, so the card around it doesn't clip
     its children, neither at their own edges (clipChildren) nor at its padding (clipToPadding). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/level_name"
        style="@style/Label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-4dp"
        android:layout_marginEnd="-4dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/level_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-8dp"
            android:importantForAccessibility="no"
            android:padding="8dp" />

        <SeekBar
            android:id="@+id/level_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressBackgroundTint="@color/text2"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:id="@+id/level_value"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text2"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
