<?xml version="1.0" encoding="utf-8"?>
<!-- A room's level: its name, then the mini player's volume row exactly, as the main screen's settings have it: a 40dp
     icon slot, the slider, the value centred in 48dp. -11dp at the start: a glyph drawn 3dp into its box starts on the
     name's line; RoomActivity sets the Sub's, drawn 4dp in. The box reaches 11dp above and below the glyph and the
     slider, so -1dp at the top and -11dp at the foot count the margins from what shows: 10dp from the name, as segments
     are, and the next margin, or the card's edge, from the row's foot. 28dp above: settings 28dp apart; the first under a
     card's title is set to 20dp where it's included. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="28dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/level_name"
        style="@style/Label" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-1dp"
        android:layout_marginBottom="-11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/level_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-11dp"
            android:importantForAccessibility="no"
            android:padding="8dp" />

        <SeekBar
            android:id="@+id/level_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressBackgroundTint="@color/text2"
            android:progressTint="@color/accent"
            android:thumbTint="@color/accent" />

        <TextView
            android:id="@+id/level_value"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text2"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
