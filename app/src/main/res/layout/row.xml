<?xml version="1.0" encoding="utf-8"?>
<!-- One room or server: the device's own icon when it has one, its name, and a detail line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/panel"
    android:clipToPadding="false"
    android:foreground="@drawable/press"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/tile"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text2"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- A room's circle: ✓ in the group the player controls, ○ not; a tap groups or ungroups it. Its glyph
         where the 24dp box was, the 12dp around it a 48dp touch area of its own, reaching into the row's padding, so
         the row keeps its height; its feedback a 40dp circle, whole inside the row, which leaves its padding unclipped. -->
    <ImageView
        android:id="@+id/check"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-10dp"
        android:layout_marginBottom="-4dp"
        android:background="@drawable/control"
        android:contentDescription="@string/group"
        android:padding="12dp"
        android:src="@drawable/ic_check"
        android:tint="@color/text"
        android:visibility="gone" />

    <!-- A server opens: the same chevron as a folder in Browse. The row's last glyph ends 20dp inside the row, as the
         Play circle does inside the mini player: ✓ stops 2dp inside its box, › 8dp. -->
    <ImageView
        android:id="@+id/chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="-4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron"
        android:visibility="gone" />
</LinearLayout>
