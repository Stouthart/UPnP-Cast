<?xml version="1.0" encoding="utf-8"?>
<!-- The remembered device addresses belong to this phone's network: never back them up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
