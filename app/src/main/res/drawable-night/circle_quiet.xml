<!-- Dark mode's Previous and Next circle: one step lighter than the panel grey, the cards' outline grey. Small, round
     and holding a light icon, the panel grey looked darker than the Queue button's in the same tone. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="52dp"
        android:height="52dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/divider" />
        </shape>
    </item>
</layer-list>
