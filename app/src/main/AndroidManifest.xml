<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Any socket needs INTERNET; the app only talks to devices on the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17: a runtime permission for apps targeting it; unknown to Android 14 to 16, which ignore it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- To follow WiFi coming and going; granted at install, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The system's media player while the room plays, also in the background (MediaControls): a service of the media
         kind, granted at install, no prompt. Its notification is a media session's, which Android 13 and later show
         without the notification permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- configChanges: rotating or resizing keeps each screen as it is (no new search, no reload, the same place in
         a list); the layouts adapt by themselves, and the tile columns and the Now Playing cover follow in code.
         enableOnBackInvokedCallback: Android 16 calls Browse's Back (up a level) by default; 14 and 15 only with it.
         No fixed orientation here: upright on a phone only, decided in code (uprightOnPhone). -->
    <application
        android:dataExtractionRules="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UpnpCast">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BrowseActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />

        <activity
            android:name=".NowPlayingActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />

        <activity
            android:name=".RoomActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />

        <activity
            android:name=".QueueActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />

        <service
            android:name=".MediaControlsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
